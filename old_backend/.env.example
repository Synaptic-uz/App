# =============================================================================
# Synaptic AI — Backend environment variables
# Copy to .env and fill in values:  cp .env.example .env
# =============================================================================

# --- Server ---
PORT=3006
# Public base URL for tracking links (optional; defaults to request host)
# PUBLIC_URL=https://api.example.com

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/synaptic-ai
# Seed fon navbatda ishlaydi; server darhol ochiladi (embedding default O‘CHIQ).
# SKIP_DB_SEED=1
# Ishga tushganda demo kampaniya embeddinglarini yangilash (sekin, GitHub API):
# EMBED_ON_STARTUP=1
# EMBEDDING_TIMEOUT_MS=25000

# --- Auth (dashboard JWT; change in production) ---
JWT_SECRET=change-me-to-a-long-random-secret
# JWT_ACCESS_EXPIRES=1h
# JWT_REFRESH_EXPIRES=7d
# INITIAL_WALLET_BALANCE=2000000
# ALLOW_MOCK_DEPOSIT=1

# --- GitHub Models API (embeddings + LLM enrichment) ---
# Create at: https://github.com/settings/tokens (models/inference access)
# Without this: seeding works without embeddings; matching falls back to keywords
GITHUB_TOKEN=

# --- Ad ranking weights (optional; defaults shown) ---
# AD_WEIGHT_BID=0.4
# AD_WEIGHT_RELEVANCE=0.3
# AD_WEIGHT_CTR=0.2
# AD_WEIGHT_RANDOM=0.1
# AD_TOP_K=5
# AD_RECENT_WINDOW=8
# AD_MAX_SAME_IN_WINDOW=2
# AD_MAX_OWNER_IN_WINDOW=4

# =============================================================================
# Dashboard (Vite) — copy these to dashboard/.env if API is on another host
# Dev uses vite proxy (/api → localhost:3006); production may need:
# =============================================================================
# VITE_API_URL=/api
# VITE_AUTH_URL=/authorized
# VITE_TRACKING_URL=http://localhost:3006
