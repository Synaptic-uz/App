# Synaptic AI — FastAPI backend (full API)
# cp .env.example .env

PORT=3007
MONGODB_URI=mongodb://localhost:27017/synaptic-ai

JWT_SECRET=change-me-to-a-long-random-secret
# JWT_ACCESS_EXPIRES=1h
# JWT_REFRESH_EXPIRES=7d
# INITIAL_WALLET_BALANCE=2000000
# ALLOW_MOCK_DEPOSIT=1
# AGENT_REVENUE_SHARE=0.7
# PUBLIC_URL=https://api.example.com

GITHUB_TOKEN=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT_MS=25000

# Ad ranking weights (optional)
# AD_WEIGHT_BID=0.4
# AD_WEIGHT_RELEVANCE=0.3
# AD_WEIGHT_CTR=0.2
# AD_WEIGHT_RANDOM=0.1

# Vector DB (Qdrant) — docker compose up -d qdrant
VECTOR_DB_ENABLED=1
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=synaptic_campaigns
# VECTOR_SEARCH_TOP_K=20
# VECTOR_SCORE_THRESHOLD=0.15
