# Synaptic Dashboard (Vite)
# Copy to dashboard/.env:  cp .env.example .env
#
# Local dev: leave unset — vite.config.ts proxies /api and /authorized to :3006

# API base (default: /api — same origin or proxy)

# B2B agent endpoint base (default: /authorized)

VITE_AUTH_URL=http://localhost:3006/authorized
VITE_API_URL=http://localhost:3006/api

# Chat demo sponsored ads (optional; or register agent — key saved to localStorage)
# VITE_DEMO_API_KEY=sk-synaptic-...
