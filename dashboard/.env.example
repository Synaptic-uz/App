# Synaptic Dashboard (Vite)
# Copy to dashboard/.env:  cp .env.example .env
#
# Local dev: leave unset — vite.config.ts proxies /api and /authorized to :3007

# API base (default: /api — same origin or proxy)

# B2B agent endpoint base (default: /authorized)

# Click tracking (default: /t/... on same origin via Vite proxy)
# VITE_TRACKING_URL=http://localhost:3007

# Production only: set full URLs if API is on another host
# VITE_AUTH_URL=https://api.example.com/authorized
# VITE_API_URL=https://api.example.com/api

# Chat demo — default sk-synaptic-demo is auto-used if unset
# VITE_DEMO_API_KEY=sk-synaptic-demo
